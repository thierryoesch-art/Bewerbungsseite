# Vorlage. Kopiere diese Datei nach .env und trage echte Werte ein.
# .env selbst gehoert NICHT ins Git-Repository.

# Port, auf dem der Server lauscht.
PORT=3000

# Zugaenge fuer Unternehmen.
# Format: benutzername:bcrypt-hash , mehrere durch Komma getrennt.
# Den Hash erzeugst du mit: npm run hash -- "meinPasswort"
LOGINS=firma-beispiel:$2b$12$ERSETZ_MICH_DURCH_EINEN_ECHTEN_HASH

# Schluessel, mit dem das Sitzungscookie signiert wird.
# Mindestens 32 zufaellige Zeichen. Erzeugen z.B. mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ERSETZ_MICH_DURCH_EINEN_ZUFALLSSTRING

# Wie lange eine Anmeldung gilt.
SESSION_DAUER=8h
